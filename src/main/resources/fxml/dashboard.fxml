<!--                            </children>-->
<!--                        </StackPane>-->

                        <VBox spacing="10.0" alignment="CENTER_LEFT" prefWidth="160.0">
                            <children>
                                <Label text="Today's Tasks" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Comic Sans MS';"/>
                                <ListView fx:id="taskPreviewList" prefWidth="160.0" prefHeight="140.0"/>
