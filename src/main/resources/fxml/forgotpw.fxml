<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<?import javafx.geometry.Insets?>
<VBox spacing="16"
  alignment="CENTER"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="controller.ForgotPasswordController">
  <padding>
    <Insets top="30" right="30" bottom="30" left="30"/>
  </padding>
  <ImageView fitHeight="300" fitWidth="400" preserveRatio="true">
    <image>
      <Image url = "@/UIPictures/forgotpw.png"/>
    </image>
  </ImageView>
  <Label text="Forgot Password?" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-font-family: 'Comic Sans MS'; -fx-text-fill: white;"/>

  <TextField fx:id="usernameField" promptText="Username" />
  <PasswordField fx:id="passwordField" promptText="New password" />
  <PasswordField fx:id="confirmPassword" promptText="Confirm new password" />
  <Button fx:id="confirmButton" text="Confirm" onAction="#handlePWChange" style="-fx-background-color: white; -fx-text-fill: black; -fx-pref-width: 220px; -fx-pref-height: 45px; -fx-font-family: 'Comic Sans MS';"/>
  <Button fx:id="homeButton" text="Return to Home" onAction="#handleReturnHome" style="-fx-background-color: white; -fx-text-fill: black; -fx-pref-width: 220px; -fx-pref-height: 45px; -fx-font-family: 'Comic Sans MS';"/>

</VBox>
