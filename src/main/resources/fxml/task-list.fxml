<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns = "http://javafx.com/javafx"
            xmlns:fx = "http://javafx.com/fxml"
            fx:controller = "controller.TaskListController">

    <center>
        <VBox spacing="12" prefWidth="520" prefHeight="650" minHeight="6500">
            <padding>
                <Insets top = "20" right = "20" bottom = "20" left = "20" />
            </padding>

            <Label text = "Task List" style = "-fx-font-size: 24px; -fx-font-weight: bold;" />
            <TextField fx:id="titleField" promptText=" Enter task name" />

            <TextArea fx:id="descriptionArea" promptText="Task Description" prefRowCount="4" />

            <DatePicker fx:id="dueDatePicker" promptText="Select due date"/>
            <ComboBox fx:id = "priorityBox" promptText="Priority" />
            <ComboBox fx:id = "repeatBox" promptText="Repeat" />
            <ComboBox fx:id = "sortBox" promptText="Sort Tasks" onAction="#handleSortTasks"/>

            <HBox spacing="10" >
                <Button text="Add Task" onAction="#handleAddTask" />
                <Button text="Edit Task" onAction="#handleEditTask" />
                <Button fx:id="saveChangesButton" text = "Save Changes" onAction="#handleSaveChanges" visible="false" managed = "false"/>
                <Button fx:id="completeTaskButton" text = "Complete Task" onAction="#handleCompleteTask" visible="false" managed = "false"/>
                <Button text="Delete Task" onAction="#handleDeleteTask" />
            </HBox>

            <!-- <ListView fx:id = "taskListView" minHeight="180" prefWidth="180" VBox.vgrow="ALWAYS"/>
            removed this and switch to tab panse so user can switch from active task to completed task window-->

            <TabPane prefHeight="300" VBox.vgrow="ALWAYS" ">
                <tabs>
                    <Tab text="Active Tasks" closable="false">
                        <ListView fx:id="taskListView" minHeight="180" prefWidth="380"/>
                    </Tab>

                    <Tab text="Completed Tasks" closable="false">
                        <ListView fx:id="completedTaskListView" minHeight="180" prefWidth="380"/>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
