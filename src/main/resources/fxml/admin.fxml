<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="640.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminController">

    <children>
        <VBox spacing="20.0"
              alignment="CENTER"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <children>
                <Label fx:id="titleLabel"
                       text="Admin Panel"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Comic Sans MS';"/>

                <VBox spacing="10.0" alignment="CENTER" prefWidth="360.0">
                    <children>
                        <Label text="Admin access enabled"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Comic Sans MS';"/>
                        <Label fx:id="currentAdminLabel"
                               text="Logged in as admin"
                               style="-fx-font-size: 15px; -fx-text-fill: white; -fx-font-family: 'Comic Sans MS';"/>
                    </children>
                </VBox>

                <HBox spacing="12.0" alignment="CENTER">
                    <children>
                        <Button text="dashboard"
                                onAction="#handleDashboard"
                                style="-fx-background-color: white; -fx-text-fill: black; -fx-pref-width: 220px; -fx-pref-height: 45px; -fx-font-family: 'Comic Sans MS';"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
